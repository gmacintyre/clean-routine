@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var nav = ViewData["Nav"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Clean Routine</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Clean Routine" />
    <meta name="theme-color" content="#F1F4F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111714" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(signedIn ? "has-nav" : "")">
    @Html.AntiForgeryToken()
    <main>
        @RenderBody()
    </main>

    @if (signedIn)
    {
        <nav class="tabbar" aria-label="Sections">
            <div class="in">
                <a href="/" aria-current="@(nav == "today" ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>Today
                </a>
                <a href="/Calendar" aria-current="@(nav == "calendar" ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>Calendar
                </a>
                <a href="/Routine" aria-current="@(nav == "routine" ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>Routine
                </a>
                <a href="/Settings" aria-current="@(nav == "settings" ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>Reminders
                </a>
            </div>
        </nav>
    }
    <div id="toast" class="toast" role="status" hidden></div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
