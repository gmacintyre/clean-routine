@page
@model RoutineModel
@using CleanRoutine.Domain
@{
    ViewData["Title"] = "Routine";
    ViewData["Nav"] = "routine";
}

@functions {
    // A chore row: tap it to edit. The right side says when it happens.
    private async Task ChoreLink(CleaningTask t, bool showWhen)
    {
        <a class="chore" href="/Chore/@t.Id">
            <span class="t">@t.Title</span>
            @if (showWhen)
            {
                <span class="when">@(t.Frequency == Frequency.Once ? t.Date?.ToString("ddd MMM d") : $"{Schedule.Ordinal(t.WeekOfMonth ?? 1)} {t.Weekday?.ToString()[..3]}")</span>
            }
            <span class="chev" aria-hidden="true">›</span>
        </a>
        await Task.CompletedTask;
    }

    private async Task AddLink(string href, string label)
    {
        <a class="chore add-chore" href="@href"><span class="plus" aria-hidden="true">+</span><span class="t">@label</span></a>
        await Task.CompletedTask;
    }
}

<div class="dayhead">
    <span class="eyebrow">Routine</span>
    <div class="row spread wrap">
        <h1>Chores</h1>
        <a class="btn" href="/Chore">+ Add a chore</a>
    </div>
    <p class="note">Tap a chore to rename it, change how often it happens, move it to another day, or delete it. Changes show up for both of you.</p>
</div>

<section class="section" id="daily">
    <div class="group-h"><h2>Every day</h2><span class="count">@Model.Of(Frequency.Daily).Count()</span></div>
    <div class="list">
        @foreach (var t in Model.Of(Frequency.Daily))
        {
            await ChoreLink(t, false);
        }
        @{ await AddLink("/Chore?frequency=Daily", "Add a daily chore"); }
    </div>
</section>

<section class="section">
    <h2>Every week</h2>
    <p class="note">Each day has a zone. Rename it to whatever fits.</p>
    @foreach (var w in Schedule.WeekOrder)
    {
        <div class="day-block" id="day-@((int)w)">
            <form method="post" asp-page-handler="Zone" class="zone-row">
                <input type="hidden" name="day" value="@w" />
                <span class="eyebrow">@w.ToString()[..3]</span>
                <input class="txt" id="zone-@((int)w)" name="name" value="@Model.Zones[(int)w]" placeholder="Name this day" aria-label="@w zone name" maxlength="40" data-autosubmit />
                <button type="submit" class="hidden-submit">Save</button>
            </form>
            <div class="list">
                @foreach (var t in Model.Of(Frequency.Weekly).Where(t => t.Weekday == w))
                {
                    await ChoreLink(t, false);
                }
                @{ await AddLink($"/Chore?frequency=Weekly&weekday={w}", $"Add a {w} chore"); }
            </div>
        </div>
    }
</section>

<section class="section" id="monthly">
    <div class="group-h"><h2>Once a month</h2><span class="count">@Model.Of(Frequency.Monthly).Count()</span></div>
    <div class="list">
        @foreach (var t in Model.Of(Frequency.Monthly).OrderBy(t => t.WeekOfMonth).ThenBy(t => t.Weekday))
        {
            await ChoreLink(t, true);
        }
        @{ await AddLink("/Chore?frequency=Monthly", "Add a monthly chore"); }
    </div>
</section>

<section class="section" id="seasonal">
    <div class="group-h"><h2>Every season</h2><span class="count">Jan · Apr · Jul · Oct</span></div>
    <div class="list">
        @foreach (var t in Model.Of(Frequency.Seasonal).OrderBy(t => t.WeekOfMonth).ThenBy(t => t.Weekday))
        {
            await ChoreLink(t, true);
        }
        @{ await AddLink("/Chore?frequency=Seasonal", "Add a seasonal chore"); }
    </div>
</section>

<section class="section" id="once">
    <div class="group-h"><h2>One-off jobs</h2><span class="count">Coming up</span></div>
    <div class="list">
        @foreach (var t in Model.UpcomingOnce)
        {
            await ChoreLink(t, true);
        }
        @{ await AddLink("/Chore?frequency=Once", "Add a one-off job"); }
    </div>
</section>

<partial name="_Ad" model="@("routine")" />

@section Scripts {
    @if (TempData["Toast"] is string toast)
    {
        <script>cr.toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toast)));</script>
    }
}
