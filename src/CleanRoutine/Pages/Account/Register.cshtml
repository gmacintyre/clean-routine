@page
@model CleanRoutine.Pages.Account.RegisterModel
@using CleanRoutine.Services
@{
    ViewData["Title"] = "Create account";
}

<div class="auth">
    <div class="dayhead">
        <span class="eyebrow">Apron Strings</span>
        <h1>Create your account</h1>
        <p class="note">Only the household's two email addresses can sign up.</p>
    </div>
    @if (!Model.SignUpOpen)
    {
        <p class="banner">Sign-up is closed. Add your email addresses to the Household__AllowedEmails__0 and Household__AllowedEmails__1 app settings first.</p>
    }
    else
    {
        <form method="post" class="card">
            @if (Model.Error is not null)
            {
                <p class="error" role="alert">@Model.Error</p>
            }
            <div class="field">
                <label for="Name">First name</label>
                <input class="txt" asp-for="Name" autocomplete="given-name" required maxlength="40" />
            </div>
            <div class="field">
                <label for="Email">Email</label>
                <input class="txt" asp-for="Email" type="email" autocomplete="username" required />
            </div>
            <div class="field">
                <label for="Password">Password</label>
                <input class="txt" asp-for="Password" type="password" autocomplete="new-password" required minlength="@AccountService.MinPasswordLength" />
                <span class="note">At least @AccountService.MinPasswordLength characters.</span>
            </div>
            <button class="btn" type="submit">Create account</button>
        </form>
    }
    <p class="note">Already have one? <a asp-page="Login">Sign in</a></p>
</div>
