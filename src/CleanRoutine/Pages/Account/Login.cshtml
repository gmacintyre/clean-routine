@page
@model CleanRoutine.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth">
    <div class="dayhead">
        <span class="eyebrow">Apron Strings</span>
        <h1>Sign in</h1>
    </div>
    <form method="post" class="card">
        @if (Model.Error is not null)
        {
            <p class="error" role="alert">@Model.Error</p>
        }
        <div class="field">
            <label for="Email">Email</label>
            <input class="txt" asp-for="Email" type="email" autocomplete="username" required autofocus />
        </div>
        <div class="field">
            <label for="Password">Password</label>
            <input class="txt" asp-for="Password" type="password" autocomplete="current-password" required />
        </div>
        <button class="btn" type="submit">Sign in</button>
    </form>
    @if (Model.SignUpOpen)
    {
        <p class="note">First time here? <a asp-page="Register">Create your account</a></p>
    }
</div>
